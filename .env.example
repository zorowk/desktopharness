# 复制为 .env.local 后填写真实值：
#   cp .env.example .env.local
#   chmod 600 .env.local
CUA_BACKEND_MODE=embedded
CUA_MODEL_BASE_URL=https://your-qwen-endpoint.example/v1
CUA_MODEL=qwen3_rl
CUA_MODEL_API_KEY=replace-me
CUA_MODEL_TLS_VERIFY=1
CUA_MODEL_TRUST_ENV=0
CUA_MODEL_TIMEOUT=120
# One prediction is exactly one computer_use action. Keep completion output bounded.
CUA_MAX_TOKENS=1024
CUA_MAX_RESPONSE_CHARS=16384
